---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CheckCard from '../../components/CheckCard.astro';
import { getChecks, tallyText } from '../../lib/checks';

const entries = await getCollection('reality-check', ({ data }) => data.draft !== true && data.category !== 'headline');
const checks = await getChecks();
const labels = {
  myth: 'Myths',
  guide: 'Guides',
  tracker: 'Tracker',
};
const grouped = {
  myth: entries.filter((entry) => entry.data.category === 'myth'),
  guide: entries.filter((entry) => entry.data.category === 'guide'),
  tracker: entries.filter((entry) => entry.data.category === 'tracker'),
};
---

<Base
  title="Reality Check | Progressives for AI"
  description="Evidence-forward AI reality checks for progressives."
>
  <main class="rc-hub">
    <div class="container">
      <h1>Reality Check</h1>
      <p class="dek">Evidence-forward pages built to separate real AI concerns from bad statistics and easy panic.</p>

      <div class="rc-columns">
      <div class="rc-col">
      <h2 class="col-title">Topics</h2>

      {entries.length === 0 ? (
        <div class="empty-state">
          <h2>Reality Checks coming soon</h2>
          <p>The hub is ready. Published pages will appear here once they clear sourcing review.</p>
        </div>
      ) : (
        Object.entries(grouped).map(([category, items]) => (
          items.length > 0 && (
            <section class="hub-group">
              <h2>{labels[category]}</h2>
              <div class="hub-list">
                {items.map((entry) => (
                  <a href={`/reality-check/${entry.id}/`} class="hub-entry">
                    <span class="badge">{labels[entry.data.category].slice(0, -1)} · {entry.data.topic}</span>
                    <h3>{entry.data.title}</h3>
                    <p>{entry.data.dek}</p>
                  </a>
                ))}
              </div>
            </section>
          )
        ))
      )}
      </div>

      <aside class="rc-col">
        <h2 class="col-title"><a href="/checks/">Headline checks</a></h2>
        <p class="col-dek">{checks.length > 0 ? `AI headlines, checked. ${tallyText(checks)}.` : 'AI headlines, checked.'}</p>
        {checks.length === 0 ? (
          <div class="empty-state">
            <p>No headline checks published yet. <a href="/checks/send-a-headline/">Send us a headline</a> you want checked.</p>
          </div>
        ) : (
          <div class="check-list">
            {checks.slice(0, 5).map((check) => <CheckCard check={check} compact />)}
            <a class="see-all" href="/checks/">See all headline checks</a>
          </div>
        )}
      </aside>
      </div>
    </div>
  </main>
</Base>
