---
// "Check our sources": one card per source, original first. Card ids are source-1..N so
// inline <sup><a href="#source-N"> citations jump to the card (and :target highlights it).
// Fed raw frontmatter from the MDX body, so it parses with the same schema the build uses.
import { z } from 'astro/zod';
import { MODEL_RESULTS, RECHECK_STATUSES, sourceSchema, sourceTypeById } from '../lib/check-scale.mjs';

interface Props {
  sources: unknown[];
  num?: string;
}

const { num } = Astro.props;
const sources = z.array(sourceSchema).parse(Astro.props.sources);

const fmt = (iso: string) => {
  const [y, m, d] = iso.split('-').map(Number);
  const opts: Intl.DateTimeFormatOptions = { year: 'numeric', timeZone: 'UTC', ...(m && { month: 'short' }), ...(d && { day: 'numeric' }) };
  return new Intl.DateTimeFormat('en', opts).format(new Date(Date.UTC(y, (m || 1) - 1, d || 1)));
};
const resultLabel = (id: string) => MODEL_RESULTS.find((r) => r.id === id)?.label ?? id;
const recheckLabel = (id: string) => RECHECK_STATUSES.find((r) => r.id === id)?.label ?? id;
---

<section class="check-sources" id="sources" aria-labelledby="sources-heading">
  <h2 id="sources-heading">{num && <span class="num">{num}</span>}Check our sources</h2>
  <p class="cs-lede">
    Every source below was read by two AI models separately, Claude Haiku and ChatGPT, to confirm it says
    what we say it does, and we re-check each link every month. Open any of them and see for yourself.
    <a href="/checks/how-we-check/#sources">How we check sources</a>
  </p>
  <ol class="source-cards">
    {sources.map((s, i) => {
      const v = s.verification;
      const rc = v.recheck;
      const rcOk = rc?.status === 'ok';
      return (
        <li id={`source-${i + 1}`} class:list={['source-card', { original: s.isOriginal }]}>
          <div class="sc-tags">
            <span class="sc-num" aria-label={`Source ${i + 1}`}>{i + 1}</span>
            {s.isOriginal && <span class="original-tag">Original source</span>}
            <span class="source-type">{sourceTypeById(s.type)?.label}</span>
          </div>
          <div class="sc-outlet">{s.outlet} · {fmt(s.date)}</div>
          <h3 class="sc-title">{s.title}</h3>
          <p class="sc-claim"><span class="sc-label">What it backs up</span>{s.supportsClaim}</p>
          <blockquote class="sc-quote">“{s.quote}”</blockquote>
          <a class="sc-open" href={s.url} rel="noopener" target="_blank">Open source<span aria-hidden="true"> ↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>
          <ul class="sc-checks">
            {(['haiku', 'chatgpt'] as const).map((model) => {
              const c = v[model];
              const name = model === 'haiku' ? 'Claude Haiku' : 'ChatGPT';
              return c ? (
                <li class={`sc-check r-${c.result}`}>
                  <span class="sc-icon" aria-hidden="true">{c.result === 'doesnt-support' ? '✕' : c.result === 'unread' && !c.confirmedBy ? '!' : '✓'}</span>
                  {c.result === 'unread' ? (
                    <span>{name} couldn't read the page · {fmt(c.date)}{c.confirmedBy ? <> · <strong>checked by hand by {c.confirmedBy}</strong></> : <> · <strong>needs a person to check</strong></>}</span>
                  ) : (
                    <span>Checked by {name} · {fmt(c.date)} · <strong>{resultLabel(c.result)}</strong>{c.result !== 'supports' && c.note && <span class="sc-note"> {c.note}</span>}</span>
                  )}
                </li>
              ) : (
                <li class="sc-check r-pending"><span class="sc-icon" aria-hidden="true">…</span><span>{name} check pending</span></li>
              );
            })}
            {rc ? (
              <li class:list={['sc-check', 'sc-recheck', rcOk ? 'r-supports' : 'r-warn']}>
                <span class="sc-icon" aria-hidden="true">{rcOk ? '↻' : '!'}</span>
                <span>
                  {rcOk ? (
                    <>Last re-checked {fmt(rc.date)} · {rc.jevConfidence == null ? 'link still live' : 'still live and still says this'}</>
                  ) : (
                    <><strong>{recheckLabel(rc.status)}</strong> · re-checked {fmt(rc.date)}</>
                  )}
                </span>
              </li>
            ) : (
              <li class="sc-check r-pending"><span class="sc-icon" aria-hidden="true">↻</span><span>Monthly re-check not run yet</span></li>
            )}
          </ul>
          {v.sample && <p class="sc-sample">Sample results for testing the page.</p>}
        </li>
      );
    })}
  </ol>
</section>
